# RAIL operational state (knowledge remains in registered KRAIL projects)
RAIL_PROJECT_REGISTRY_PATH=.rail/platform-projects.json
RAIL_MANAGED_WORKSPACE_ROOT=.rail/projects
RAIL_LINKED_PROJECT_ROOTS=
RAIL_RUN_STORE_PATH=.rail/platform-runs.json
RAIL_RUN_MAX_WORKERS=4
RAIL_WEB_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Explicitly opt in only for trusted non-dry workflows.
RAIL_FULL_ACCESS_ENABLED=false

# Server-side web-to-API origin.
KRAIL_API_BASE_URL=http://127.0.0.1:8000
# Browser run-control origin; keep aligned with the local API and RAIL_WEB_ORIGINS.
NEXT_PUBLIC_KRAIL_API_URL=http://127.0.0.1:8000/api/v1
